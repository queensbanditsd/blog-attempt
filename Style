/* ---------------------------------------------------------
   Tokens
--------------------------------------------------------- */
:root {
  --bg:      #000000;
  --ink:     #ffffff;
  --muted:   #8a8a8a;
  --line:    #2b2b2b;
  --line-strong: #ffffff;

  --serif: 'Source Serif 4', 'Iowan Old Style', Georgia, 'Times New Roman', serif;
  --mono:  'IBM Plex Mono', 'SF Mono', 'Courier New', monospace;

  --sidebar-w: 232px;
  --content-max: 640px;
}

* { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--serif);
  font-size: 17px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; }

::selection { background: #ffffff; color: #000000; }

/* ---------------------------------------------------------
   Sidebar / nav
--------------------------------------------------------- */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: var(--sidebar-w);
  height: 100vh;
  border-right: 1px solid var(--line);
  padding: 40px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  text-decoration: none;
  color: var(--ink);
}

.brand-mark {
  width: 40px;
  height: auto;
  flex-shrink: 0;
  margin-top: 2px;
}

.brand-mark path,
.brand-mark circle {
  stroke: var(--ink);
}

.brand-name {
  font-family: var(--mono);
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.3;
}

.brand-tagline {
  display: block;
  font-family: var(--mono);
  font-size: 0.68rem;
  color: var(--muted);
  letter-spacing: 0.03em;
  margin-top: 3px;
}

.site-nav {
  margin-top: 44px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.site-nav a {
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  color: var(--muted);
  padding: 7px 0;
  border-bottom: 1px solid transparent;
  width: fit-content;
}

.site-nav a:hover {
  color: var(--ink);
}

.site-nav a.active {
  color: var(--ink);
  border-bottom-color: var(--ink);
}

.sidebar-foot {
  font-family: var(--mono);
  font-size: 0.68rem;
  color: var(--muted);
  letter-spacing: 0.02em;
}

/* ---------------------------------------------------------
   Main content
--------------------------------------------------------- */
main {
  margin-left: var(--sidebar-w);
  padding: 64px 48px 120px;
  max-width: calc(var(--content-max) + 96px);
}

.page-intro {
  max-width: var(--content-max);
  color: var(--muted);
  font-family: var(--mono);
  font-size: 0.85rem;
  line-height: 1.7;
  margin: 0 0 56px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--line);
}

/* ---------------------------------------------------------
   Feed / entries
--------------------------------------------------------- */
.feed {
  max-width: var(--content-max);
}

.entry {
  padding: 34px 0;
  border-bottom: 1px solid var(--line);
}

.entry:first-child { padding-top: 0; }
.entry:last-child { border-bottom: none; }

.entry-date {
  display: block;
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 12px;
}

.entry-title {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 1.28rem;
  margin: 0 0 10px;
  line-height: 1.35;
}

.entry-body {
  font-size: 1.03rem;
  line-height: 1.75;
}

.entry-body p {
  margin: 0 0 1em;
}

.entry-body p:last-child { margin-bottom: 0; }

/* ---------------------------------------------------------
   About page
--------------------------------------------------------- */
.page-title {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 1.6rem;
  margin: 0 0 28px;
  max-width: var(--content-max);
}

.prose {
  max-width: var(--content-max);
  font-size: 1.03rem;
  line-height: 1.8;
}

.prose p { margin: 0 0 1.2em; }

.elsewhere {
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid var(--line);
  max-width: var(--content-max);
}

.elsewhere-label {
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  display: block;
  margin-bottom: 10px;
}

.elsewhere a {
  font-family: var(--mono);
  font-size: 0.85rem;
  text-decoration: underline;
  text-underline-offset: 3px;
  margin-right: 18px;
  color: var(--ink);
}

/* ---------------------------------------------------------
   Empty state
--------------------------------------------------------- */
.empty {
  font-family: var(--mono);
  font-size: 0.85rem;
  color: var(--muted);
}

/* ---------------------------------------------------------
   Responsive — sidebar collapses to a top bar
--------------------------------------------------------- */
@media (max-width: 820px) {
  .sidebar {
    position: static;
    width: 100%;
    height: auto;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-right: none;
    border-bottom: 1px solid var(--line);
    padding: 20px 24px;
  }

  .brand-mark { width: 30px; }
  .brand-tagline { display: none; }

  .site-nav {
    margin-top: 0;
    flex-direction: row;
    gap: 18px;
  }

  .sidebar-foot { display: none; }

  main {
    margin-left: 0;
    padding: 44px 24px 80px;
  }
}

@media (max-width: 480px) {
  body { font-size: 16px; }
  .entry-title { font-size: 1.15rem; }
}
